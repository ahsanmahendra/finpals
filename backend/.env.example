PORT=3000
NODE_ENV=development

# ─── MySQL ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finpals

# ─── JWT ──────────────────────────────────
JWT_SECRET=finpals_super_secret_change_this_in_production
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=finpals_refresh_secret_change_this

# ─── Midtrans Sandbox ──────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_WITH_YOUR_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_WITH_YOUR_KEY

# ─── Brevo (Email) ─────────────────────────
BREVO_API_KEY=xkeysib-REPLACE_WITH_YOUR_KEY
BREVO_FROM_EMAIL=noreply@finpals.app
BREVO_FROM_NAME=Finpals

# ─── Fonnte (WhatsApp OTP) ─────────────────
FONNTE_TOKEN=REPLACE_WITH_YOUR_FONNTE_TOKEN

# ─── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_SECRET

# ─── Gemini AI (optional) ──────────────────
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# ─── App ───────────────────────────────────
APP_URL=http://localhost:3000
# For physical device testing:
# APP_URL=https://xxxx.ngrok.io

# ─── Premium Price ─────────────────────────
PREMIUM_PRICE_IDR=29000
